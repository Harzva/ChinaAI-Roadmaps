{
  "name": "chinaai-benchmark-registry",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "audit": "node scripts/audit-inventory.mjs",
    "sync:catalogs": "node scripts/sync-registry-catalogs.mjs",
    "arxiv:discover": "node scripts/arxiv-discover.mjs",
    "arxiv:stage": "node scripts/arxiv-stage.mjs",
    "arxiv:fixture": "node scripts/arxiv-discover.mjs --date 2026-07-18 --fixture data/arxiv/papers.json && node scripts/arxiv-stage.mjs",
    "arxiv:promote": "node scripts/arxiv-promote.mjs",
    "arxiv:build": "node scripts/arxiv-build.mjs",
    "arxiv:validate": "node scripts/arxiv-validate.mjs",
    "build": "node scripts/arxiv-build.mjs && node scripts/build-leaderboards.mjs",
    "validate": "node scripts/validate-data.mjs && node scripts/arxiv-validate.mjs && node scripts/arxiv-promote.mjs",
    "test": "node --test tests/*.test.mjs",
    "links": "node scripts/check-links.mjs",
    "security": "node scripts/scan-public.mjs",
    "gates": "node scripts/run-gates.mjs"
  },
  "engines": {
    "node": ">=20"
  }
}
