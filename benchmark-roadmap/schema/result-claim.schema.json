{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "result-claim.schema.json",
  "title": "Result Claim",
  "type": "object",
  "required": [
    "claimId",
    "paperId",
    "candidateId",
    "dataset",
    "datasetVersion",
    "system",
    "metric",
    "runConfig",
    "evidence",
    "status",
    "sourceType",
    "comparability",
    "rankingEligible",
    "createdAt"
  ],
  "properties": {
    "claimId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "paperId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "candidateId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "dataset": {
      "type": "string",
      "minLength": 1
    },
    "datasetVersion": {
      "type": "string",
      "minLength": 1
    },
    "system": {
      "type": "string",
      "minLength": 1
    },
    "metric": {
      "type": "object",
      "required": [
        "name",
        "direction",
        "unit",
        "value"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "direction": {
          "type": "string",
          "enum": [
            "higher",
            "lower"
          ]
        },
        "unit": {
          "type": "string",
          "minLength": 1
        },
        "value": {
          "type": "number"
        },
        "normalizedValue": {
          "type": ["number", "null"]
        }
      },
      "additionalProperties": false
    },
    "runConfig": {
      "type": "object",
      "required": ["raw"],
      "properties": {
        "raw": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "steps": {
              "type": "integer",
              "minimum": 1
            },
            "training_free": {
              "type": "boolean"
            },
            "zero_shot": {
              "type": "boolean"
            },
            "maxTurns": {
              "type": "integer",
              "minimum": 1
            },
            "episodes": {
              "type": "integer",
              "minimum": 1
            },
            "subset": {
              "type": "string"
            },
            "backbone": {
              "type": "string"
            },
            "promptVariant": {
              "type": "string"
            },
            "notes": {
              "type": "string"
            }
          }
        },
        "configId": {
          "type": "string",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "notes": {
          "type": "string"
        }
      },
      "additionalProperties": false
    },
    "evidence": {
      "type": "object",
      "required": [
        "pdfPage",
        "table",
        "row",
        "column",
        "sourcePdfUrl",
        "pdfSha256"
      ],
      "properties": {
        "sourcePdfUrl": {
          "type": "string",
          "pattern": "^https://arxiv\\.org/pdf/"
        },
        "pdfSha256": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        },
        "pdfPage": {
          "type": "integer",
          "minimum": 1
        },
        "table": {
          "type": "string",
          "minLength": 1
        },
        "row": {
          "type": "string",
          "minLength": 1
        },
        "column": {
          "type": "string",
          "minLength": 1
        },
        "figure": {
          "type": "string"
        },
        "textSnippet": {
          "type": "string"
        },
        "extractionMethod": {
          "type": "string",
          "enum": ["native_text", "table_parser", "ocr", "visual_review"]
        }
      },
      "additionalProperties": false
    },
    "status": {
      "type": "string",
      "enum": [
        "candidate",
        "agent_verified",
        "human_verified",
        "ocr_only",
        "rejected"
      ]
    },
    "rankingEligible": {
      "type": "boolean"
    },
    "sourceType": {
      "type": "string",
      "enum": ["paper_reported"]
    },
    "comparability": {
      "type": "string",
      "enum": ["unreviewed", "partially_comparable", "not_comparable", "comparable"]
    },
    "rankReason": {
      "type": "string"
    },
    "createdAt": {
      "type": "string",
      "format": "date-time"
    },
    "reviewedAt": {
      "type": "string",
      "format": "date-time"
    }
  },
  "additionalProperties": false
}
