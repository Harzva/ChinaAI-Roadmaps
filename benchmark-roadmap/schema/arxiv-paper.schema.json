{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "arxiv-paper.schema.json",
  "title": "ArXiv Paper Record",
  "type": "object",
  "required": [
    "paperId",
    "arxivId",
    "version",
    "title",
    "authors",
    "arxivUrl",
    "pdfUrl",
    "pdfSha256",
    "submittedAt"
  ],
  "properties": {
    "paperId": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "arxivId": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{4,5}$"
    },
    "version": {
      "type": "string",
      "pattern": "^v[0-9]+$"
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "authors": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "arxivUrl": {
      "type": "string",
      "pattern": "^https://"
    },
    "pdfUrl": {
      "type": "string",
      "pattern": "^https://arxiv\\.org/pdf/"
    },
    "pdfSha256": {
      "type": "string",
      "pattern": "^sha256:[a-f0-9]{64}$"
    },
    "submittedAt": {
      "type": "string",
      "format": "date-time"
    },
    "updatedAt": {
      "type": "string",
      "format": "date-time"
    },
    "categories": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "summary": {
      "type": "string"
    },
    "license": {
      "type": "string"
    },
    "pageCount": {
      "type": "integer",
      "minimum": 1
    },
    "downloadedAt": {
      "type": "string",
      "format": "date-time"
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "queryBuckets": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "watchlists": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "uniqueItems": true
    },
    "textLayer": {
      "type": "string",
      "enum": ["usable", "partial", "missing", "unchecked"]
    },
    "metadata": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source": {
          "type": "string",
          "minLength": 1
        },
        "rawSourceUrl": {
          "type": "string",
          "pattern": "^https://"
        },
        "rawPayloadHash": {
          "type": "string",
          "pattern": "^sha256:[a-f0-9]{64}$"
        }
      }
    }
  },
  "additionalProperties": false
}
