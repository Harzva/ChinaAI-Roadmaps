{"$schema":"https://json-schema.org/draft/2020-12/schema","$id":"benchmark.schema.json","title":"Benchmark","type":"object","required":["benchmarkId","type","canonicalName","category","owner","status","versions","languages","modalities","timeWindow","primaryMetric","links","sourceIds"],"properties":{"benchmarkId":{"type":"string","pattern":"^[a-z0-9-]+$"},"type":{"enum":["benchmark","suite","framework","dataset","protocol","audit_method"]},"status":{"enum":["collecting","needs_source","legacy","ready"]},"languages":{"type":"array","minItems":1,"items":{"type":"string"}},"modalities":{"type":"array","minItems":1,"items":{"type":"string"}},"primaryMetric":{"type":"object","required":["name","unit","direction"],"properties":{"direction":{"enum":["higher","lower"]}}},"sourceIds":{"type":"array","minItems":1},"registryOrigin":{"type":"object","properties":{"catalogId":{"type":"string"},"catalogRole":{"enum":["implementation-index","paper-evidence"]},"upstreamPath":{"type":"string"},"upstreamCommit":{"type":"string","pattern":"^[a-f0-9]{40}$"},"originalSourceStatus":{"enum":["pending-audit"]},"paperId":{"type":"string","pattern":"^arxiv-[a-z0-9-]+$"},"sourceVersion":{"type":"string","pattern":"^v[0-9]+$"},"discoveredAt":{"type":"string","format":"date"}},"required":["catalogId","catalogRole"],"allOf":[{"if":{"properties":{"catalogRole":{"const":"implementation-index"}}},"then":{"required":["upstreamPath","upstreamCommit","originalSourceStatus"]}},{"if":{"properties":{"catalogRole":{"const":"paper-evidence"}}},"then":{"required":["paperId","sourceVersion","discoveredAt"]}}]}},"additionalProperties":true}
